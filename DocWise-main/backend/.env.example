NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://docwise:docwise@localhost:5432/docwise

JWT_ACCESS_SECRET=your-access-secret-minimum-32-characters-here
JWT_REFRESH_SECRET=your-refresh-secret-minimum-32-characters-here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Embedding Provider Configuration
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Voyage AI (recommended by Anthropic for Claude-compatible embeddings)
VOYAGE_API_KEY=...
VOYAGE_EMBEDDING_MODEL=voyage-3
ANTHROPIC_API_KEY=sk-ant-...
COHERE_API_KEY=...
COHERE_EMBEDDING_MODEL=embed-multilingual-v3.0

# LLM Configuration
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-20241022

PINECONE_API_KEY=...
PINECONE_INDEX=docwise-index

S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
S3_BUCKET_NAME=docwise-files
S3_REGION=auto

REDIS_URL=redis://localhost:6379

NMI_PRIVATE_API_KEY=your_nmi_private_api_key
NMI_API_BASE_URL=https://secure.nmi.com/api/v5
NMI_PLAN_STARTER=STARTER
NMI_PLAN_PRO=PRO
NMI_WEBHOOK_SECRET=your_shared_hmac_secret
NMI_WEBHOOK_EVENTS=subscription.created,subscription.updated,subscription.cancelled

RESEND_API_KEY=re_...
EMAIL_FROM=noreply@docwise.ai
